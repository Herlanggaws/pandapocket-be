# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Server Configuration
GIN_MODE=debug
PORT=8080

# JWT Configuration
JWT_SECRET=secret-key
REFRESH_TOKEN_SECRET=secret-refresh-key
# Access tokens last 15 minutes in code. JWT_EXPIRATION_HOURS is not read.
REFRESH_TOKEN_EXPIRATION_HOURS=168

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
APP_URL=http://localhost:3000

# Comma-separated email domains auto-marked as internal users on signup/SSO.
# Plus-address "+test" / "+test…" local parts are always internal. Default: empty.
INTERNAL_EMAIL_DOMAINS=

# PostHog (server-side product events; same distinct_id as web user id)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Sentry (API errors)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
